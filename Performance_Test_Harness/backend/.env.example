# Snowflake connection (defaults match the original app.py)
SNOWFLAKE_ACCOUNT=SFSEEUROPE-EU_DEMO59
SNOWFLAKE_USER=JACK
SNOWFLAKE_DATABASE=THEMES_RESEARCH_DEMO
SNOWFLAKE_SCHEMA=RAW_DATA
PRIVATE_KEY_PATH=./keys/rsa_key.p8

# Java engine
JAVA_HOME=/usr/lib/jvm/java-17-amazon-corretto.x86_64
JAVA_HARNESS_DIR=./java-harness
JDBC_JAR_PATH=./lib/snowflake-jdbc.jar
SLF4J_API_JAR=./lib/slf4j-api.jar
SLF4J_SIMPLE_JAR=./lib/slf4j-simple.jar

# Warehouse used to read INFORMATION_SCHEMA / ACCOUNT_USAGE metrics
METRICS_WAREHOUSE=COMPUTE_WH

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated CORS origins allowed to call the API (your laptop's frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
