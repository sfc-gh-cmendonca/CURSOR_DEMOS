[Unit]
Description=GTIF Ask the Fund web app
After=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/gtif_app/server
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=STATIC_DIR=/home/ec2-user/gtif_app/web/dist
Environment=SNOWFLAKE_PRIVATE_KEY_PATH=/home/ec2-user/gtif_app/server/keys/rsa_key.p8
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
